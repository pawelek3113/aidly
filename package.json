{
  "name": "aidly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "dotenv -e .env.test -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "bunx prettier --check .",
    "format:write": "bunx prettier --write .",
    "test:e2e:install": "npx playwright install",
    "test:e2e": "docker compose up -d db-test && npx playwright test",
    "test:e2e:ui": "docker compose up -d db-test && npx playwright test --ui",
    "test:e2e:codegen": "docker compose up -d db-test && start-server-and-test dev:test http://localhost:3000 \"npx playwright codegen http://localhost:3000/\"",
    "db:up": "docker compose up -d db",
    "db:test": "docker compose up -d db-test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "ENV_FILE=.env.test drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:studio:test": "ENV_FILE=.env.test drizzle-kit studio",
    "prepare": "husky",
    "email:dev": "email dev --dir ./src/server/mail/templates --port 3001"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "1.7.0-rc.2",
    "@hookform/resolvers": "^5.7.1",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-three/fiber": "^9.3.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@vercel/functions": "^3.8.0",
    "@wrksz/themes": "^1.0.0",
    "better-auth": "1.7.0-rc.2",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "next-intl": "^4.13.4",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.1",
    "react-hook-form": "^7.84.0",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-email/ui": "6.9.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "sharp",
    "unrs-resolver"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
